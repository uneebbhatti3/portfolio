# All variables are optional. Copy to .env.local for local development and set
# the real values in Vercel → Project → Settings → Environment Variables.

# Canonical site URL, no trailing slash. Defaults to https://uneebbhatti.vercel.app.
# Set this when a custom domain is connected.
NEXT_PUBLIC_SITE_URL=

# Google Search Console "HTML tag" verification token (the content="..." value only).
# The <meta name="google-site-verification"> tag is emitted only when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity project ID. The Clarity script loads only when this is set.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
